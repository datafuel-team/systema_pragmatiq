---
import Seo from '../components/Seo.astro';
import Sidebar from '../components/Sidebar.astro';
import { CONTACTS, METRIKA_ID, SITE_NAME } from '../lib/sections';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  rawTitle?: boolean;
  noindex?: boolean;
  ogImage?: string;
  publishedAt?: string;
  updatedAt?: string;
  /** простая подпись в топбаре (без ссылки) */
  crumb?: string;
  /** крошки со ссылками: [{label, href?}]; последняя — текущая страница */
  crumbs?: { label: string; href?: string }[];
  /** теги материала → schema.org about (темы в контентной аналитике Метрики) */
  tags?: string[];
  /** раздел материала → schema.org articleSection (рубрика) */
  sectionTitle?: string;
}

const {
  title, description, rawTitle, noindex, ogImage, publishedAt, updatedAt, crumb, crumbs, tags, sectionTitle,
} = Astro.props;

const crumbItems = crumbs ?? (crumb ? [{ label: crumb }] : []);

// BreadcrumbList для поисковиков: Главная + переданные крошки
const SITE = 'https://sistema.pragmatiq.online';
const breadcrumbSchema =
  crumbItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
          ...crumbItems.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: c.label,
            ...(c.href ? { item: `${SITE}${c.href}` } : {}),
          })),
        ],
      }
    : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <Seo
      {title}
      {description}
      {rawTitle}
      {noindex}
      {ogImage}
      {publishedAt}
      {updatedAt}
      {tags}
      {sectionTitle}
    />
    <script is:inline>
      // до отрисовки — чтобы сайдбар не мигал
      if (localStorage.getItem('nav-collapsed') === '1' && window.innerWidth > 900) {
        document.addEventListener('DOMContentLoaded', function () {
          document.body.classList.add('nav-collapsed');
        });
      }
    </script>
  </head>
  <body data-metrika={METRIKA_ID}>
    <noscript><div><img src={`https://mc.yandex.ru/watch/${METRIKA_ID}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <header class="topbar">
      <button class="nav-expand" id="nav-expand" aria-label="Открыть меню" title="Открыть меню">›</button>
      {
        crumbItems.length > 0 && (
          <nav class="topbar-crumbs" aria-label="Хлебные крошки">
            <a href="/">Главная</a>
            {crumbItems.map((c) => (
              <>
                <span class="crumb-sep">/</span>
                {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-cur">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      <a class="topbar-cta" href={CONTACTS.telegram} rel="noopener">↳ Подписаться на новости</a>
    </header>

    <Sidebar />

    <div class="layout">
      <main class="main">
        <slot />
      </main>
      <footer class="footer">
        <span>© Прагматик, {new Date().getFullYear()}</span>
        <a href={CONTACTS.site} rel="noopener">{CONTACTS.siteLabel}</a>
        <a href={CONTACTS.telegram} rel="noopener">{CONTACTS.telegramLabel}</a>
        <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a>
        <span style="margin-left:auto">{SITE_NAME}</span>
      </footer>
    </div>

    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <script>
      const expandBtn = document.getElementById('nav-expand');
      const collapseBtn = document.getElementById('nav-collapse');
      const mobile = () => window.matchMedia('(max-width: 900px)').matches;
      const toggleNav = () => {
        if (mobile()) {
          document.body.classList.toggle('nav-open');
        } else {
          const collapsed = document.body.classList.toggle('nav-collapsed');
          localStorage.setItem('nav-collapsed', collapsed ? '1' : '0');
        }
      };
      expandBtn?.addEventListener('click', toggleNav);
      collapseBtn?.addEventListener('click', toggleNav);
      // клик мимо сайдбара на мобильном закрывает меню
      document.addEventListener('click', (e) => {
        if (!mobile() || !document.body.classList.contains('nav-open')) return;
        const t = e.target as Node;
        if (
          !document.getElementById('sidebar')?.contains(t) &&
          !expandBtn?.contains(t as Node)
        ) {
          document.body.classList.remove('nav-open');
        }
      });
    </script>

    <script>
      // Цели Яндекс.Метрики (JS-события). Названия целей — в Метрике, счётчик 103432924.
      const counter = Number(document.body.dataset.metrika);
      const goal = (name: string, params?: Record<string, string>) => {
        const ym = (window as any).ym;
        if (counter && typeof ym === 'function') ym(counter, 'reachGoal', name, params);
      };

      // Клики: подписка на канал, личка, шаринг, инструмент, переход на сайт агентства
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest('a[href], button');
        if (!el) return;
        const href = el.getAttribute('href') ?? '';
        if (href.startsWith('https://t.me/pragmatik_agency')) return goal('tg_subscribe');
        if (href.startsWith('https://t.me/kalash_nick')) return goal('tg_contact');
        if (href.startsWith('https://t.me/share/url')) {
          return goal('share', { via: el.hasAttribute('data-sendme') ? 'sendme' : 'telegram' });
        }
        if (el.classList.contains('share-sys')) return goal('share', { via: 'system' });
        if (el.classList.contains('share-copy')) return goal('share', { via: 'copy' });
        if (href.startsWith('/tools/')) return goal('tool_open');
        if (el.classList.contains('next-chapter')) return goal('next_chapter');
        if (/^https?:\/\/(www\.)?pragmatiq\.ru/.test(href)) return goal('site_pragmatiq');
      });

      // Чтение материала: половина текста и дочитывание (конец текста виден + не меньше 30 с на странице).
      // Геометрия проверяется по скроллу и раз в секунду — без rAF/IntersectionObserver, которые
      // молчат в фоновых вкладках.
      const prose = document.querySelector('.prose');
      if (prose) {
        const started = Date.now();
        let half = false;
        let full = false;
        const check = () => {
          const r = prose.getBoundingClientRect();
          if (!half && window.innerHeight >= r.top + r.height / 2) {
            half = true;
            goal('read_half');
          }
          if (!full && r.bottom <= window.innerHeight && Date.now() - started >= 30000) {
            full = true;
            goal('read_full');
          }
          if (half && full) {
            clearInterval(timer);
            window.removeEventListener('scroll', check);
          }
        };
        const timer = setInterval(check, 1000);
        window.addEventListener('scroll', check, { passive: true });
        check();
      }
    </script>
  </body>
</html>
