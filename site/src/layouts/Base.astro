---
import Seo from '../components/Seo.astro';
import Sidebar from '../components/Sidebar.astro';
import { CONTACTS, SITE_NAME } from '../lib/sections';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  rawTitle?: boolean;
  noindex?: boolean;
  ogImage?: string;
  publishedAt?: string;
  updatedAt?: string;
  /** простая подпись в топбаре (без ссылки) */
  crumb?: string;
  /** крошки со ссылками: [{label, href?}]; последняя — текущая страница */
  crumbs?: { label: string; href?: string }[];
}

const { title, description, rawTitle, noindex, ogImage, publishedAt, updatedAt, crumb, crumbs } =
  Astro.props;

const crumbItems = crumbs ?? (crumb ? [{ label: crumb }] : []);

// BreadcrumbList для поисковиков: Главная + переданные крошки
const SITE = 'https://sistema.pragmatiq.online';
const breadcrumbSchema =
  crumbItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
          ...crumbItems.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: c.label,
            ...(c.href ? { item: `${SITE}${c.href}` } : {}),
          })),
        ],
      }
    : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <Seo
      {title}
      {description}
      {rawTitle}
      {noindex}
      {ogImage}
      {publishedAt}
      {updatedAt}
    />
    <script is:inline>
      // до отрисовки — чтобы сайдбар не мигал
      if (localStorage.getItem('nav-collapsed') === '1' && window.innerWidth > 900) {
        document.addEventListener('DOMContentLoaded', function () {
          document.body.classList.add('nav-collapsed');
        });
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <button class="nav-expand" id="nav-expand" aria-label="Открыть меню" title="Открыть меню">›</button>
      {
        crumbItems.length > 0 && (
          <nav class="topbar-crumbs" aria-label="Хлебные крошки">
            <a href="/">Главная</a>
            {crumbItems.map((c) => (
              <>
                <span class="crumb-sep">/</span>
                {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-cur">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      <a class="topbar-cta" href={CONTACTS.telegram} rel="noopener">↳ Подписаться на новости</a>
    </header>

    <Sidebar />

    <div class="layout">
      <main class="main">
        <slot />
      </main>
      <footer class="footer">
        <span>© Прагматик, {new Date().getFullYear()}</span>
        <a href={CONTACTS.site} rel="noopener">{CONTACTS.siteLabel}</a>
        <a href={CONTACTS.telegram} rel="noopener">{CONTACTS.telegramLabel}</a>
        <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a>
        <span style="margin-left:auto">{SITE_NAME}</span>
      </footer>
    </div>

    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <script>
      const expandBtn = document.getElementById('nav-expand');
      const collapseBtn = document.getElementById('nav-collapse');
      const mobile = () => window.matchMedia('(max-width: 900px)').matches;
      const toggleNav = () => {
        if (mobile()) {
          document.body.classList.toggle('nav-open');
        } else {
          const collapsed = document.body.classList.toggle('nav-collapsed');
          localStorage.setItem('nav-collapsed', collapsed ? '1' : '0');
        }
      };
      expandBtn?.addEventListener('click', toggleNav);
      collapseBtn?.addEventListener('click', toggleNav);
      // клик мимо сайдбара на мобильном закрывает меню
      document.addEventListener('click', (e) => {
        if (!mobile() || !document.body.classList.contains('nav-open')) return;
        const t = e.target as Node;
        if (
          !document.getElementById('sidebar')?.contains(t) &&
          !expandBtn?.contains(t as Node)
        ) {
          document.body.classList.remove('nav-open');
        }
      });
    </script>
  </body>
</html>
