---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MaterialCard from '../../components/MaterialCard.astro';
import { SECTIONS } from '../../lib/sections';

export async function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.id }, props: { section: s } }));
}

const { section } = Astro.props;
const items = (await getCollection(section.id, ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title={section.title} description={section.description} crumb={section.title}>
  <div class="content">
    <div class="page-head">
      <div class="page-head-eyebrow">
        <span>✦</span> Раздел {String(section.order).padStart(2, '0')}
      </div>
      <h1 class="page-head-title">{section.title}</h1>
      <p class="page-head-sub">{section.description}</p>
    </div>

    <div class="section">
      {
        items.length > 0 ? (
          <div class="mat-grid">
            {items.map((item) => (
              <MaterialCard
                href={`/${section.id}/${item.id}/`}
                title={item.data.title}
                description={item.data.description}
                sectionId={section.id}
                date={item.data.date}
                type={item.data.type}
              />
            ))}
          </div>
        ) : (
          <p style="color:var(--muted)">
            Раздел наполняется. Новые материалы появляются каждую неделю — следите в
            <a href="https://t.me/pragmatik_agency" style="color:var(--blue)" rel="noopener"> телеграм-канале</a>.
          </p>
        )
      }
    </div>
  </div>
</Base>
