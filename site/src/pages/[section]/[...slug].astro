---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Related from '../../components/Related.astro';
import { SITE_NAME, STORY_SERIES } from '../../lib/sections';
import { visibleSections } from '../../lib/nav';

export async function getStaticPaths() {
  const paths = [];
  for (const s of await visibleSections()) {
    const items = await getCollection(s.id, ({ data }) => !data.draft);
    // серия читается подряд, поэтому каждой главе нужен указатель на следующую
    const byChapter = [...items].sort(
      (a, b) => (a.data.story?.chapter ?? 0) - (b.data.story?.chapter ?? 0)
    );
    for (const entry of items) {
      const i = byChapter.indexOf(entry);
      const next = s.id === 'stories' && i > -1 ? byChapter[i + 1] : undefined;
      paths.push({
        params: { section: s.id, slug: entry.id },
        props: { entry, section: s, next: next ? { id: next.id, data: next.data } : null },
      });
    }
  }
  return paths;
}

const { entry, section, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
// A/B-тест длины текста: если для материала есть src/ab/<slug>.md, страница несёт обе версии,
// а показывает одну — вариант закрепляется за браузером в localStorage (см. inline-скрипт ниже).
// Полная версия стоит в HTML первой и видима по умолчанию: её индексируют поисковики.
const abMods = import.meta.glob('../../ab/*.md', { eager: true }) as Record<string, any>;
const abMod = abMods[`../../ab/${entry.id}.md`];
const ShortContent = abMod?.Content;
const abTest = abMod ? `len_${entry.id}` : null;
const dateStr = d.date.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isTool = d.type === 'tool' && d.tool;
const isStory = d.type === 'story' && !!d.story;
const toc = !isStory && !isTool ? headings.filter((h) => h.depth === 2) : [];
const showToc = toc.length >= 5;
const shareUrl = new URL(Astro.url.pathname, 'https://sistema.pragmatiq.online').href;
// Рубрика для контентной аналитики Метрики: она ищет BreadcrumbList внутри элемента материала
// (#material) и берёт name с наибольшей position — поэтому здесь только раздел, без заголовка.
const rubricSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: { '@id': `https://sistema.pragmatiq.online/${section.id}/`, name: section.title },
    },
  ],
};
const shareText = `${d.title} — ${SITE_NAME}`;
---

<Base
  title={d.seoTitle ?? d.title}
  description={d.description}
  crumbs={[{ label: section.title, href: `/${section.id}/` }, { label: d.title }]}
  publishedAt={d.date.toISOString()}
  updatedAt={d.updated?.toISOString()}
  ogImage={`/og/${section.id}/${entry.id}.png`}
  tags={d.tags}
  sectionTitle={section.title}
>
  <div class="content">
    <article>
      <a class="back-link" href={`/${section.id}/`}>← {section.title}</a>
      <header class="mat-head">
        <div>
          <div class="mat-card-meta" style="margin-bottom:12px;">
            <a class="badge badge-gray" href={`/${section.id}/`}>{section.title}</a>
            {isTool && <span class="badge badge-lime">Инструмент</span>}
            {isStory && (
              <span class="badge badge-blue">
                Глава {String(d.story.chapter).padStart(2, '0')}
              </span>
            )}
            <span class="mat-date">{dateStr}</span>
          </div>
          <h1 style="font-size:30px; font-weight:700; line-height:1.2;">{d.title}</h1>
          {
            isStory && (
              <a class="story-series" href={STORY_SERIES.href}>
                ✦ Серия «{STORY_SERIES.title}» · глава {d.story.chapter} из {STORY_SERIES.total}
              </a>
            )
          }
          {
            isStory ? (
              <p class="story-concept">{d.story.concept}</p>
            ) : (
              <p style="font-size:16px; color:var(--muted); margin-top:10px; max-width:720px;">
                {d.description}
              </p>
            )
          }
          {
            d.meta.length > 0 && (
              <div class="meta-panel">
                {d.meta.map((m) => (
                  <div class="meta-item">
                    <div class="m-lbl">{m.label}</div>
                    <div class="m-val">{m.value}</div>
                  </div>
                ))}
              </div>
            )
          }
        </div>
      </header>

      {
        d.tldr.length > 0 && (
          <div class="tldr">
            <span class="tldr-tag">Коротко</span>
            <ul>
              {d.tldr.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        showToc && (
          <details class="toc">
            <summary>Содержание · {toc.length} разделов</summary>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      {
        isStory && d.cover && (
          <figure class="story-hero">
            <img src={d.cover} alt="" width="1200" height="720" />
          </figure>
        )
      }

      {
        isTool && (
          <>
            <div class="tool-cta card">
              <div class="card-title">Открыть конструктор</div>
              <p style="margin-bottom:18px; color:var(--muted); font-size:14px;">
                Инструмент открывается отдельной страницей во весь экран — периодической
                таблице из 165 УТП нужна ширина. Бесплатно, без регистрации.
              </p>
              <a class="btn btn-lime" href={d.tool.src} target="_blank" rel="noopener">
                ↗ Открыть конструктор УТП
              </a>
            </div>
            <div class="mobile-gate" style="margin-bottom:32px;">
              <div class="card-title">Инструмент доступен с компьютера</div>
              <p style="margin-bottom:16px; color:var(--muted); font-size:13px;">
                Интерактивная таблица не помещается на экран телефона.
                Откройте эту страницу с компьютера — или отправьте себе ссылку в Telegram.
              </p>
              <a class="btn btn-lime" data-sendme={`${section.id}/${entry.id}`} href={`https://t.me/share/url?url=${encodeURIComponent(new URL(Astro.url.pathname, 'https://sistema.pragmatiq.online').href)}`}>
                ↳ Отправить себе в Telegram
              </a>
            </div>
          </>
        )
      }

      <div id="material" class:list={['prose', { 'prose-story': isStory }]} data-ab={abTest}>
        <script type="application/ld+json" set:html={JSON.stringify(rubricSchema)} />
        {
          ShortContent ? (
            <>
              <div class="ab-variant" data-variant="long">
                <Content />
              </div>
              <div class="ab-variant" data-variant="short" hidden>
                <ShortContent />
              </div>
              <script is:inline>
                // Выбор варианта до отрисовки текста: 50/50, закрепляется за браузером.
                (function () {
                  var m = document.getElementById('material');
                  var test = m.getAttribute('data-ab');
                  var key = 'ab_' + test;
                  var v = null;
                  try { v = localStorage.getItem(key); } catch (e) {}
                  if (v !== 'short' && v !== 'long') {
                    v = Math.random() < 0.5 ? 'short' : 'long';
                    try { localStorage.setItem(key, v); } catch (e) {}
                  }
                  var vs = m.querySelectorAll('.ab-variant');
                  for (var i = 0; i < vs.length; i++) vs[i].hidden = vs[i].getAttribute('data-variant') !== v;
                  window.__ab = { test: test, variant: v };
                })();
              </script>
            </>
          ) : (
            <Content />
          )
        }
      </div>

      {
        isStory && (
          <div class="story-end">
            <div class="share">
              <span class="share-label">Поделиться главой</span>
              <a
                class="btn btn-lime share-tg"
                href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`}
                target="_blank"
                rel="noopener"
              >
                ✈ В Telegram
              </a>
              <button class="btn btn-outline share-sys" type="button" hidden
                data-url={shareUrl} data-title={d.title} data-text={shareText}>
                ↗ Поделиться
              </button>
              <button class="btn btn-outline share-copy" type="button" data-url={shareUrl}>
                ⧉ Копировать ссылку
              </button>
            </div>

            {next ? (
              <a class="next-chapter" href={`/stories/${next.id}/`}>
                <span class="nc-eyebrow">
                  Следующая глава · {String(next.data.story.chapter).padStart(2, '0')}
                </span>
                <span class="nc-title">{next.data.title}</span>
                {next.data.story.teaser && <span class="nc-teaser">{next.data.story.teaser}</span>}
                <span class="nc-go">Читать дальше ↳</span>
              </a>
            ) : d.story.chapter >= STORY_SERIES.total ? (
              <div class="next-chapter next-chapter--end">
                <span class="nc-eyebrow">Конец</span>
                <span class="nc-title">Двадцатая глава — последняя</span>
                <span class="nc-teaser">
                  «{STORY_SERIES.title}» — серия из двадцати рассказов о том, как
                  нейробиология работает в продажах недвижимости, и о том, что она делает
                  с тем, кто её применяет.
                </span>
                <a class="nc-go" href="/stories/">Все главы серии ↳</a>
              </div>
            ) : (
              <div class="next-chapter next-chapter--last">
                <span class="nc-eyebrow">Продолжение следует</span>
                <span class="nc-title">Это последняя опубликованная глава</span>
                <span class="nc-teaser">
                  Следующие главы выходят по мере готовности.
                </span>
                <a class="nc-go" href="/stories/">Все главы серии ↳</a>
              </div>
            )}
          </div>
        )
      }
    </article>

    <Related related={d.related} tags={d.tags} selfId={`${section.id}/${entry.id}`} />
  </div>

  <script>
    // Системное «Поделиться» (iOS, Android, macOS) — там оно открывает приложение Telegram
    const sys = document.querySelector('.share-sys') as HTMLButtonElement | null;
    if (sys && typeof navigator.share === 'function') {
      sys.hidden = false;
      sys.addEventListener('click', () => {
        navigator
          .share({
            title: sys.dataset.title,
            text: sys.dataset.text,
            url: sys.dataset.url,
          })
          .catch(() => {});
      });
    }

    const copy = document.querySelector('.share-copy') as HTMLButtonElement | null;
    copy?.addEventListener('click', async () => {
      const url = copy.dataset.url;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        return;
      }
      const was = copy.textContent;
      copy.textContent = '✓ Скопировано';
      setTimeout(() => (copy.textContent = was), 1800);
    });
  </script>
</Base>
