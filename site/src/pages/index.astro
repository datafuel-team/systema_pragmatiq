---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MaterialCard from '../components/MaterialCard.astro';
import { SECTIONS, SITE_NAME } from '../lib/sections';

type Entry = { sectionId: string; id: string; data: any };
const all: Entry[] = [];
for (const s of SECTIONS) {
  const items = await getCollection(s.id, ({ data }) => !data.draft);
  let entries = items.map((item) => ({ sectionId: s.id, id: item.id, data: item.data }));
  // серия целиком затопила бы ленту: показываем одну карточку — вход в свежую серию
  if (s.id === 'stories') {
    entries = entries
      .sort(
        (a, b) =>
          b.data.date.valueOf() - a.data.date.valueOf() ||
          (a.data.story?.chapter ?? 0) - (b.data.story?.chapter ?? 0)
      )
      .slice(0, 1);
  }
  all.push(...entries);
}
const latest = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 12);
---

<Base
  title={SITE_NAME}
  rawTitle
  description="Открытая система маркетинга недвижимости от агентства «Прагматик»: методологии, инструменты, кейсы и разборы для маркетологов застройщиков."
  crumb="Главная"
>
  <div class="content">
    <div class="page-head">
      <div class="page-head-eyebrow"><span>✦</span> Прагматик · маркетинг недвижимости</div>
      <h1 class="page-head-title">Система прагматичного<br />маркетинга недвижимости</h1>
      <p class="page-head-sub">
        Методологии, инструменты и кейсы, на которых мы строим маркетинг застройщиков.
        Открытая часть — для всех. Рабочие материалы — по входу через Telegram.
      </p>
    </div>

    <div class="section">
      <div class="section-title">01 &nbsp; Новые материалы</div>
      <div class="mat-grid">
        {
          latest.map((e) => (
            <MaterialCard
              href={`/${e.sectionId}/${e.id}/`}
              title={e.data.title}
              description={e.data.description}
              sectionId={e.sectionId}
              date={e.data.date}
              type={e.data.type}
              chapter={e.data.story?.chapter}
            />
          ))
        }
      </div>
    </div>

    <div class="section">
      <div class="section-title">02 &nbsp; Разделы</div>
      <div class="mat-grid">
        {
          SECTIONS.map((s) => (
            <a class="mat-card" href={`/${s.id}/`}>
              <div class="mat-card-title">{s.title}</div>
              <div class="mat-card-desc">{s.description}</div>
              <div class="mat-card-arrow">↳ Открыть раздел</div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
