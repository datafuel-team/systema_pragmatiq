---
import Base from '../layouts/Base.astro';
---

<Base title="Страница не найдена" description="Такой страницы нет." noindex crumb="404">
  <div class="content" style="text-align:center; padding-top:96px;">
    <div class="page-head-eyebrow" style="justify-content:center;"><span>✦</span> Ошибка 404</div>
    <h1 style="font-size:28px; margin:12px 0 16px;">Такой страницы нет</h1>
    <p style="color:var(--muted); margin-bottom:24px;">
      Возможно, материал переехал. Начните с главной — там все свежие материалы.
    </p>
    <a class="btn btn-lime" href="/">↳ На главную</a>
  </div>
</Base>
