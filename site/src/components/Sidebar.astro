---
import { getCollection } from 'astro:content';
import { CONTACTS } from '../lib/sections';
import { visibleSections } from '../lib/nav';

const current = Astro.url.pathname;

const sections = await visibleSections();

const sectionsWithItems = await Promise.all(
  sections.map(async (s) => {
    const items = (await getCollection(s.id, ({ data }) => !data.draft))
      .sort((a, b) =>
        s.id === 'stories'
          ? (a.data.story?.chapter ?? 0) - (b.data.story?.chapter ?? 0)
          : b.data.date.valueOf() - a.data.date.valueOf()
      );
    return { ...s, items };
  })
);

const isActive = (path: string) => current === path || current === `${path}/`;
const sectionOpen = (id: string) => current.startsWith(`/${id}`);
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-head">
    <a class="side-logo" href="/">
      <img src="/img/logo-pragmatiq.svg" alt="Прагматик" width="288" height="24" />
      <small>система маркетинга недвижимости</small>
    </a>
    <button class="nav-collapse" id="nav-collapse" aria-label="Свернуть меню" title="Свернуть меню">‹</button>
  </div>
  <nav class="sidebar-nav" aria-label="Разделы">
    <a class="side-home" href="/">
      <span class="spark">✦</span>
      Главная
    </a>
    {
      sectionsWithItems.map((s) => (
        <div class:list={['side-group', { open: sectionOpen(s.id) }]} data-group={s.id}>
          <button class="side-group-head" type="button" aria-expanded={sectionOpen(s.id)}>
            <span class="glyph">✦</span>
            {s.navTitle ?? s.title}
            <span class="chev">▸</span>
          </button>
          <div class="side-group-items">
            <a class="side-hub-link" href={`/${s.id}/`}>
              ↳ Обзор раздела
            </a>
            {s.items.map((item) => (
              <a
                class:list={['side-link', { active: isActive(`/${s.id}/${item.id}`) }]}
                href={`/${s.id}/${item.id}/`}
              >
                {item.data.title}
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </nav>
  <div class="sidebar-contacts">
    <a href={CONTACTS.telegram} rel="noopener">↳ Подписаться на канал <span class="c-sub">{CONTACTS.telegramLabel}</span></a>
    <a href={CONTACTS.site} rel="noopener">↳ Сайт агентства <span class="c-sub">{CONTACTS.siteLabel}</span></a>
  </div>
</aside>

<script>
  // Сворачивание групп; состояние по клику, активная группа открыта с сервера.
  document.querySelectorAll('.side-group-head').forEach((head) => {
    head.addEventListener('click', () => {
      const group = head.closest('.side-group');
      if (!group) return;
      group.classList.toggle('open');
      head.setAttribute('aria-expanded', String(group.classList.contains('open')));
    });
  });
</script>
