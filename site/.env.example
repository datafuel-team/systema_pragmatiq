# Публичные коды аналитики и верификации (не секреты — попадают в HTML).
# Скопировать в site/.env и заполнить; для CI-сборки те же значения
# добавить в env шага Build в .github/workflows/deploy.yml.

# Счётчик Яндекс.Метрики задан константой METRIKA_ID в src/lib/sections.ts.

# Google Search Console: код из мета-тега google-site-verification
PUBLIC_GSC_VERIFICATION=

# Яндекс.Вебмастер: код из мета-тега yandex-verification.
# Значение по умолчанию (текущий подтверждённый код) прошито в src/components/Seo.astro —
# переменная нужна только чтобы его переопределить.
PUBLIC_YANDEX_VERIFICATION=
